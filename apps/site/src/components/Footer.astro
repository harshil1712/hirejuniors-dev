---
import { PROJECT } from "#project";
---
<footer>
  <div class="wrap inner">
    <nav aria-label="Footer">
      <a href="/jobs/">Jobs</a>
      <a href="/companies/">Companies</a>
      <a href="/privacy">Privacy</a>
      <a href="/jobs/rss.xml">RSS</a>
    </nav>
    <span>{PROJECT.productName}</span>
  </div>
</footer>
<style>
  footer {
    border-top: 1px solid var(--color-kumo-line);
  }
  .inner {
    padding-block: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    font-size: 14px;
    color: var(--color-kumo-subtle);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  nav a { color: var(--color-kumo-default); }
</style>
