---
import Logo from "@hirejuniors/brand/Logo.astro";
import { PROJECT } from "#project";
const path = Astro.url.pathname;
const links = [
  { href: "/jobs/", label: "Jobs", match: (p: string) => p.startsWith("/job") },
  { href: "/companies/", label: "Companies", match: (p: string) => p.startsWith("/companies") },
];
---
<header class="wrap nav">
  <a class="home" href="/" aria-label={`${PROJECT.productName} home`}>
    <Logo size={24} wordmark />
  </a>
  <nav aria-label="Main">
    {links.map((l) => (
      <a href={l.href} aria-current={l.match(path) ? "page" : undefined}>{l.label}</a>
    ))}
    <button class="theme" type="button" data-theme-toggle aria-label="Switch to dark theme">
      <svg class="moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.4 14.6A8.5 8.5 0 0 1 9.4 3.6a8.5 8.5 0 1 0 11 11Z"/></svg>
      <svg class="sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
  </nav>
</header>
<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
    border-bottom: 1px solid var(--color-kumo-line);
  }
  .home {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    border-radius: 6px;
    color: var(--color-kumo-default);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 15px;
    font-weight: 500;
  }
  nav a {
    color: var(--color-kumo-default);
    text-decoration: none;
    border-radius: 4px;
  }
  nav a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  nav a[aria-current] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .theme {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: none;
    color: var(--color-kumo-subtle);
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
  }
  .theme:hover {
    color: var(--color-kumo-default);
    background: var(--color-kumo-recessed);
  }
  .sun,
  :global(html[data-mode="dark"]) .moon {
    display: none;
  }
  :global(html[data-mode="dark"]) .sun {
    display: block;
  }
  @media (max-width: 480px) {
    .nav {
      height: auto;
      padding: 12px 24px;
      flex-wrap: wrap;
      row-gap: 8px;
    }
    nav {
      gap: 18px;
      font-size: 14px;
    }
    nav a {
      display: inline-flex;
      align-items: center;
      min-height: 24px;
    }
    .theme {
      width: 32px;
      height: 32px;
    }
  }
</style>

<script>
  import { applyTheme, readTheme, resolveTheme } from "@hirejuniors/brand/theme";

  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
    const label = () => {
      const next = resolveTheme(readTheme()) === "dark" ? "light" : "dark";
      btn.setAttribute("aria-label", `Switch to ${next} theme`);
    };
    label();
    btn.addEventListener("click", () => {
      applyTheme(resolveTheme(readTheme()) === "dark" ? "light" : "dark");
      label();
    });
  }
</script>