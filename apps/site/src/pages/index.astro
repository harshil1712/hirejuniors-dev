---
export const prerender = false;
import PageLayout from "../components/PageLayout.astro";
import JobList from "../components/JobList.astro";
import HubLinks from "../components/HubLinks.astro";
import PostList from "../components/PostList.astro";
import { PROJECT } from "#project";
import { siteDb } from "../lib/site-db";
import {
  listActiveJobs, countActiveJobs, levelCounts, countryCounts,
} from "@hirejuniors/db/queries";
import { countryName } from "../lib/countries";
import { breadcrumbs, itemList, cacheHeaders, CACHE_OK } from "../lib/ssr";
import { getPublishedPosts } from "../lib/posts";

cacheHeaders(Astro, CACHE_OK);
const db = siteDb();
const [total, jobs, levels, countries, latest] = await Promise.all([
  countActiveJobs(db),
  listActiveJobs(db, {}, { limit: 12 }),
  levelCounts(db),
  countryCounts(db),
  getPublishedPosts(),
]);
const levelMap = Object.fromEntries(levels.map((r) => [r.level, r.n]));
const countryList = countries
  .filter((c) => c.countryCode)
  .map((c) => ({ code: c.countryCode as string, n: c.n }));

const description =
  `Hire Juniors lists junior jobs, internships, apprenticeships and graduate roles, refreshed weekly. ${total} open roles right now.`;
const FAQ = [
  {
    q: "What counts as a junior role?",
    a: "Roles aimed at people starting out: internships, apprenticeships, graduate schemes and jobs that ask for roughly zero to two years of experience.",
  },
  {
    q: "Where do the listings come from?",
    a: "We read public job boards from companies directly — Greenhouse, Lever, Ashby and Amazon Jobs — no scraping of logged-in sites.",
  },
  {
    q: "How often is the board updated?",
    a: "The sources are re-read weekly. New postings appear after each run and closed ones are removed.",
  },
  {
    q: "What happens when a role closes?",
    a: "The listing is retired: it leaves every list, and its page answers 410 Gone with a short note and links to similar open roles.",
  },
];
const jsonLd = [
  {
    "@type": "FAQPage",
    mainEntity: FAQ.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---
<PageLayout
  title={`${PROJECT.productName} — junior jobs and internships`}
  description={description}
  width="wide"
  jsonLdEntities={jsonLd}
>
  <section class="hero">
    <h1 class="font-display">Junior jobs and internships, <em>in one place</em>.</h1>
    <p class="sub">
      {total} open roles for people starting out — internships, apprenticeships,
      graduate schemes and junior positions, collected from company job boards
      and refreshed weekly.
    </p>
    <div class="btns">
      <a class="btn cta" href="/jobs/">Browse all jobs</a>
      <a class="btn btn-secondary cta" href="/companies/">Companies</a>
    </div>
  </section>

  <section class="hubs-sec">
    <h2 class="font-display">Browse by level and country</h2>
    <HubLinks levelCounts={levelMap} countryCounts={countryList} />
  </section>

  <section class="latest-jobs">
    <h2 class="font-display">Latest roles</h2>
    <JobList jobs={jobs} />
    {jobs.length > 0 && <p class="more"><a href="/jobs/">See all {total} roles →</a></p>}
  </section>

  <section class="faq" aria-labelledby="faq-title">
    <h2 class="font-display" id="faq-title">FAQ</h2>
    {FAQ.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  {latest.length > 0 && (
    <section class="latest">
      <h2 class="font-display">From the blog</h2>
      <PostList posts={latest.slice(0, 3)} size="compact" headingLevel={3} showTags={false} />
    </section>
  )}
</PageLayout>
<style>
  .hero { padding-block: 56px 40px; max-width: 720px; }
  h1 { font-size: 56px; font-weight: 700; letter-spacing: -0.035em; line-height: 1.04; text-wrap: balance; margin: 0; }
  h1 em { font-style: normal; color: var(--brand-text); }
  .sub { margin-top: 20px; font-size: 19px; color: var(--color-kumo-subtle); line-height: 1.6; }
  .btns { margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap; }
  section { margin-bottom: 48px; }
  h2 { font-size: 26px; letter-spacing: -0.02em; margin: 0 0 16px; }
  .more { font-size: 14px; }
  .faq details { border-bottom: 1px solid var(--color-kumo-line); padding: 12px 0; }
  .faq summary { cursor: pointer; font-weight: 600; }
  .faq details p { color: var(--color-kumo-subtle); margin-top: 8px; }
  @media (max-width: 600px) { h1 { font-size: 38px; } }
</style>
