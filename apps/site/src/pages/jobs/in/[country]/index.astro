---
export const prerender = false;
import PageLayout from "../../../../components/PageLayout.astro";
import ListingPage from "../../../../components/ListingPage.astro";
import { siteDb } from "../../../../lib/site-db";
import { listActiveJobs, countActiveJobs } from "@hirejuniors/db/queries";
import { countryCodeFromSlug, countrySlug, countryName } from "../../../../lib/countries";
import { breadcrumbs, itemList, CACHE_OK, CACHE_GONE } from "../../../../lib/ssr";
import { PROJECT } from "#project";

const PER = 24;
const origin = `https://${PROJECT.domain}`;
const code = countryCodeFromSlug(Astro.params.country ?? "");
if (!code) {
  return new Response("Not found", { status: 404, headers: { "cache-control": CACHE_GONE } });
}
const name = countryName(code);
const db = siteDb();
const total = await countActiveJobs(db, { countryCode: code });
// Country hub with zero active jobs is a 404, not an empty page (spec).
if (total === 0) {
  return new Response("Not found", { status: 404, headers: { "cache-control": CACHE_GONE } });
}
const page = Math.max(1, parseInt(Astro.url.searchParams.get("page") ?? "1", 10) || 1);
const pageCount = Math.max(1, Math.ceil(total / PER));
if (page > pageCount) {
  return new Response("Not found", { status: 404, headers: { "cache-control": CACHE_GONE } });
}
Astro.response.headers.set("cache-control", CACHE_OK);
const jobs = await listActiveJobs(db, { countryCode: code }, { offset: (page - 1) * PER, limit: PER });
const title = `${total} junior jobs and internships in ${name} · ${PROJECT.productName}`;
const description = `${total} open junior roles, internships, apprenticeships and graduate positions in ${name} — refreshed weekly.`;
---
<PageLayout
  title={title}
  description={description}
  canonical={`${origin}/jobs/in/${countrySlug(code)}/`}
  width="wide"
  jsonLdEntities={[
    breadcrumbs([
      { name: "Home", path: "/" },
      { name: "Jobs", path: "/jobs/" },
      { name, path: `/jobs/in/${countrySlug(code)}/` },
    ], origin),
    itemList(jobs, origin),
  ]}
>
  <ListingPage heading={`Junior roles in ${name}`} jobs={jobs} total={total}
    page={page} pageCount={pageCount} basePath={`/jobs/in/${countrySlug(code)}/`} />
</PageLayout>
